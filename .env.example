# ========================================================
# Khushi Tiwari Portfolio - Environment Configuration
# ========================================================
# Official EmailJS credentials (https://www.emailjs.com/)
# Fill these in your local .env file or Vercel Project Environment Variables:
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# When these keys are omitted or empty, the portfolio contact form
# operates safely in interactive "Demo / Preview Mode" with full
# client-side validation and a direct mailto: fallback option.
